# syntax=docker/dockerfile:1
#
# Dockerfile.dev-workspace — Druppie per-branch developer workspace image.
#
# Build context: repo root (.) — same as the backend Dockerfile.
#
# A single-pod, browser-based developer workspace for a branch environment
# (namespace druppie-<slug>). It runs on plain HTTP, only reachable inside the
# pod / via the oauth2-proxy sidecar that another manifest wires up:
#
#   :8080  code-server (VS Code in the browser) opened on /workspace
#   :8000  backend  — uvicorn --reload (hot reload), SQLite, dev/degraded mode
#   :5173  frontend — Vite dev server with HMR
#   :6080  desktop  — XFCE over noVNC (127.0.0.1 only; reached through
#          code-server's authenticated port proxy at /proxy/6080/)
#
# This is NOT the old dev-vm image (mcp-servers/module-coding/Dockerfile.dev-vm):
# no xrdp, no Docker-in-Docker, no in-pod Gitea. The GUI is a browser desktop
# (Layer 1b) served over HTTP like everything else, and authentication is
# handled entirely by the oauth2-proxy sidecar.
#
# Layer model (see docs/research-dev-environments.md §"Dev VM base image"):
#   L1 — Debian slim + Python 3.12 + Node 20 + git + curl + build essentials
#   L2 — code-server (pinned GitHub release)
#   L3 — repo snapshot baked at build time (colab-dev HEAD) -> /opt/druppie-src
#   L4 — frontend node_modules (npm install)
#   L5 — backend virtualenv (pip install -r requirements.txt)
#
FROM python:3.12-slim-bookworm

LABEL maintainer="druppie"
LABEL description="Druppie per-branch developer workspace (code-server + hot-reload backend/frontend). ClusterIP-only, fronted by oauth2-proxy."

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

# ===========================================================================
# Layer 1 — Base OS packages + Node 20
# (Python 3.12 comes from the base image.)
# ===========================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        build-essential \
        libpq-dev \
        libffi-dev \
        openssl \
        tini \
        unixodbc-dev \
    && rm -rf /var/lib/apt/lists/* \
    && python --version && pip --version

# Union of system deps required by MCP modules that may be embedded into this
# pod (see devWorkspace.embedModules). Only adds what the base Layer 1 doesn't
# already provide:
#   docker-ce-cli  — module-coding & module-deploy talk to a mounted docker.sock
#   poppler-utils  — module-vision PDF→image conversion
# Chromium (module-coding's puppeteer + module-browser) is already installed in
# Layer 1b below; playwright's own chromium is fetched per-venv in Layer 6.
# Write the key as armored .asc — modern apt (≥1.4, Debian bookworm is 2.5+)
# reads it directly, so we avoid the `gpg --dearmor` pipe (gnupg isn't in Layer
# 1, and a broken pipe surfaces as "curl failed writing body").
RUN apt-get update \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
       > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Node 20 via NodeSource (mirrors mcp-servers/module-coding/Dockerfile.dev-vm)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version && npm --version

# Mermaid CLI — used by module-coding for structural diagram validation
# (mirrors mcp-servers/module-coding/Dockerfile). MUST set PUPPETEER_SKIP_*
# before the install: @mermaid-js/mermaid-cli pulls puppeteer, whose postinstall
# downloads ~150MB Chromium unless skipped. System Chromium (installed in Layer
# 1b below) is used at runtime via PUPPETEER_EXECUTABLE_PATH.
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
RUN npm install -g @mermaid-js/mermaid-cli

# kubectl — for read-only cluster access from the workspace terminal.
RUN curl -fsSL "https://dl.k8s.io/release/v1.32.0/bin/linux/amd64/kubectl" -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl \
    && kubectl version --client --short 2>/dev/null || kubectl version --client

# ===========================================================================
# Layer 1b — Browser desktop: XFCE + TigerVNC + noVNC (HTTP-only GUI)
# ===========================================================================
# The desktop is reached through code-server's port proxy
# (https://<workspace-host>/proxy/6080/), so it rides the same oauth2-proxy
# authentication as every other port — no new Service/Ingress. Xvnc runs
# without its own auth on 127.0.0.1 only: same trust model as code-server's
# auth:none (the oauth2-proxy sidecar is the single gate).
RUN apt-get update && apt-get install -y --no-install-recommends \
        tigervnc-standalone-server \
        novnc \
        websockify \
        xfce4-session xfwm4 xfce4-panel xfdesktop4 thunar \
        terminator \
        mousepad \
        dbus-x11 x11-xserver-utils \
        fonts-dejavu \
        chromium \
        nano \
        gnupg2 \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --set x-terminal-emulator /usr/bin/terminator

# VS Code desktop (for the noVNC XFCE session)
RUN curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > /usr/share/keyrings/packages.microsoft.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main" > /etc/apt/sources.list.d/vscode.list \
    && apt-get update && apt-get install -y --no-install-recommends code \
    && rm -rf /var/lib/apt/lists/*

# OpenCode CLI — installer puts the binary in /root/.opencode/bin/ which is
# inaccessible to the non-root developer user at runtime (drwx------). Copy
# the binary to /usr/local/bin so it is world-executable and on PATH.
RUN curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path \
    && cp /root/.opencode/bin/opencode /usr/local/bin/opencode \
    && chmod +x /usr/local/bin/opencode \
    && rm -rf /root/.opencode \
    && opencode --version

# Chromium's own sandbox needs user namespaces / SUID, which the pod's
# restricted runtime does not grant; k8s also mounts a tiny /dev/shm.
RUN printf 'export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox --disable-dev-shm-usage"\n' \
        > /etc/chromium.d/99-druppie-container

# noVNC web root: the packaged client plus an index.html that redirects to
# vnc.html with the websocket path rewritten for the /proxy/6080/ prefix.
RUN mkdir -p /opt/novnc-web && ln -s /usr/share/novnc/* /opt/novnc-web/
COPY scripts/dev-workspace-desktop-index.html /opt/novnc-web/index.html

# ===========================================================================
# Layer 2 — code-server (pinned release from GitHub)
# ===========================================================================
# Bind 0.0.0.0:8080 with auth:none ON PURPOSE. The pod is ClusterIP-only and
# the ONLY ingress path is the oauth2-proxy sidecar (built by a separate
# manifest), which terminates authentication before any request reaches this
# port. code-server must therefore not add a second, conflicting auth layer.
ARG CODE_SERVER_VERSION=4.99.3
RUN curl -fsSL "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server-${CODE_SERVER_VERSION}-linux-amd64.tar.gz" \
        -o /tmp/code-server.tar.gz \
    && mkdir -p /opt/code-server \
    && tar -xzf /tmp/code-server.tar.gz -C /opt/code-server --strip-components=1 \
    && ln -sf /opt/code-server/bin/code-server /usr/local/bin/code-server \
    && rm /tmp/code-server.tar.gz \
    && code-server --version

# Claude Code CLI (used from the integrated terminal and by the VS Code
# extension installed below). Login state lives under CLAUDE_CONFIG_DIR on
# the workspace PVC (set by the entrypoint), so it survives pod restarts.
RUN npm install -g @anthropic-ai/claude-code \
    && claude --version

# ===========================================================================
# Layer 3 — Non-root user + baked repo snapshot (colab-dev HEAD)
# ===========================================================================
# Non-root developer user (uid 1000). /workspace is the runtime checkout
# (backed by a PVC in k8s) and is owned by developer.
RUN groupadd -g 1000 developer \
    && useradd -m -u 1000 -g developer -s /bin/bash developer \
    && mkdir -p /home/developer/.kube \
    && chown developer:developer /home/developer/.kube \
    && mkdir -p /workspace \
    && chown developer:developer /workspace

# Early dependency file copies — content-hash keyed, so the heavy install
# layers below (npm install, pip install, per-module venvs) stay cached
# across commits that only change code or config, not dependency files.
COPY frontend/package.json /opt/druppie-src/frontend/
COPY druppie/requirements.txt /opt/druppie-src/druppie/
COPY druppie/mcp-servers /opt/druppie-src/druppie/mcp-servers

# ===========================================================================
# Layer 4 — Frontend node_modules
# ===========================================================================
# npm install, not npm ci: package-lock.json is gitignored repo-wide, so the
# build context has no lockfile (same reason frontend/Dockerfile uses install).
RUN cd /opt/druppie-src/frontend \
    && npm install \
    && npm cache clean --force \
    && chown -R developer:developer /opt/druppie-src/frontend/node_modules

# ===========================================================================
# Layer 5 — Backend virtualenv (pip install -r requirements.txt)
# ===========================================================================
# A relocatable venv baked at /opt/venv. The entrypoint copies it to
# /workspace/.venv on first seed and always invokes it as
# "$VENV/bin/python -m ..." (module form), which resolves site-packages from
# the executable's location — so the copy works regardless of path.
RUN python -m venv /opt/venv \
    && /opt/venv/bin/python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /opt/venv/bin/python -m pip install --no-cache-dir -r /opt/druppie-src/druppie/requirements.txt \
    && chown -R developer:developer /opt/venv

# ===========================================================================
# Layer 6 — Per-module virtualenvs (for devWorkspace.embedModules)
# ===========================================================================
# One venv per MCP module so any module can be embedded into the workspace pod
# and run under `uvicorn --reload` against the live checkout on the PVC. Each
# venv is relocated to /workspace/.venvs/<key> on first seed (same pattern as
# the backend venv) so pip reinstalls on requirements change survive pod restart.
#
# The venv KEY matches the Helm values key (modules.<key>); the SOURCE DIR is
# module-<key with _ -> -> (module-data-access for data_access). A module whose
# deps fail to install under Python 3.12 is skipped (venv dir left absent) — the
# entrypoint treats a missing venv as "not embeddable" and falls back to the
# baked-image Deployment for that module.
RUN set -e; \
    for key in coding docker filesearch web archimate registry llm \
               kubernetes vision searxng browser data_access azuredevops; do \
        dir="module-$(printf '%s' "$key" | tr '_' '-')"; \
        req="/opt/druppie-src/druppie/mcp-servers/${dir}/requirements.txt"; \
        if [ ! -f "$req" ]; then \
            echo "[dev-workspace] no requirements.txt for $key ($dir) — skipping"; \
            continue; \
        fi; \
        echo "[dev-workspace] building venv for $key ($dir)"; \
        if python -m venv "/opt/venvs/$key" \
            && "/opt/venvs/$key/bin/python" -m pip install --no-cache-dir --upgrade pip \
            && "/opt/venvs/$key/bin/python" -m pip install --no-cache-dir -r "$req"; then \
            echo "[dev-workspace] ok: $key"; \
        else \
            echo "[dev-workspace] WARN: $key venv setup failed — removing; module not embeddable"; \
            rm -rf "/opt/venvs/$key"; \
        fi; \
    done; \
    if [ -d /opt/venvs/browser ]; then \
        echo "[dev-workspace] pre-fetching playwright chromium for module-browser"; \
        /opt/venvs/browser/bin/python -m playwright install chromium || \
            echo "[dev-workspace] WARN: playwright chromium fetch failed — browser module may error at runtime"; \
    fi; \
    chown -R developer:developer /opt/venvs

# ===========================================================================
# Late: CACHEBUST + full repo copy (invalidated on every commit)
# ===========================================================================
# The whole build context is baked as an offline seed. .git is excluded by
# .dockerignore, so the entrypoint re-inits git and fetches at runtime.
# node_modules / the venvs are baked above and survive the cache bust.
ARG CACHEBUST
COPY --chown=developer:developer . /opt/druppie-src

# ===========================================================================
# Entrypoint
# ===========================================================================
COPY --chown=developer:developer scripts/dev-workspace-entrypoint.sh /usr/local/bin/dev-workspace-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/dev-workspace-entrypoint.sh \
    && chmod +x /usr/local/bin/dev-workspace-entrypoint.sh

# code-server default config (also passed explicitly on the CLI by the
# entrypoint). See the L2 comment for why auth:none is correct here.
RUN install -d -m 755 -o developer -g developer /home/developer/.config/code-server \
    && printf 'bind-addr: 0.0.0.0:8080\nauth: none\ndisable-telemetry: true\n' \
        > /home/developer/.config/code-server/config.yaml \
    && chown -R developer:developer /home/developer/.config

# VS Code desktop entry for XFCE noVNC session
RUN install -d -m 755 /usr/share/applications \
    && printf '[Desktop Entry]\nName=VS Code\nComment=Code Editing. Redefined.\nGenericName=Text Editor\nExec=/usr/share/code/code --no-sandbox --unity-launch %%F\nIcon=code\nType=Application\nStartupNotify=false\nStartupWMClass=Code\nCategories=TextEditor;Development;IDE;\nMimeType=text/plain;inode/directory;\nActions=new-empty-window;\nKeywords=vscode;\n\n[Desktop Action new-empty-window]\nName=New Empty Window\nExec=/usr/share/code/code --no-sandbox --new-window %%F\nIcon=code\n' > /usr/share/applications/code.desktop

# XFCE desktop autostart: open terminator in /workspace/druppie on session start
RUN install -d -m 755 -o developer -g developer /home/developer/.config/autostart \
    && printf '[Desktop Entry]\nType=Application\nName=Workspace Terminal\nExec=terminator --working-directory=/workspace/druppie\nX-GNOME-Autostart-enabled=true\n' > /home/developer/.config/autostart/workspace-terminal.desktop \
    && chown -R developer:developer /home/developer/.config/autostart

USER developer
WORKDIR /workspace

# Claude Code VS Code extension (Open VSX). Installed as the developer user so
# it lands in ~/.local/share/code-server; the extension drives the CLI above.
RUN code-server --install-extension Anthropic.claude-code \
    && code-server --list-extensions | grep -i claude

# code-server:8080  backend:8000  frontend/vite:5173
# MCP module ports (only bound when the module is in devWorkspace.embedModules):
#   coding:9001 docker:9002 filesearch:9004 web:9005 archimate:9006
#   registry:9007 llm:9008 data_access:9010 vision:9011 azuredevops:9012
#   kubernetes:9013 searxng:9014 browser:9015
EXPOSE 8000 5173 8080 9001 9002 9004 9005 9006 9007 9008 9010 9011 9012 9013 9014 9015

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:8080/healthz || exit 1

# tini reaps the backgrounded children the entrypoint spawns (PID 1 hygiene).
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/dev-workspace-entrypoint.sh"]
