# Druppie Platform - Init Container
# Runs Keycloak and Gitea setup scripts on first launch.
# Uses a marker volume to track initialization state.
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies:
#   - docker CLI for Gitea CLI commands under docker-compose
#   - kubectl for Gitea CLI commands when running on Kubernetes
RUN apt-get update && apt-get install -y \
    curl \
    docker.io \
    && rm -rf /var/lib/apt/lists/* \
    && curl -L -s -o /usr/local/bin/kubectl \
       "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" \
    && chmod +x /usr/local/bin/kubectl

# Install Python dependencies for setup scripts
RUN pip install --no-cache-dir requests pyyaml

ARG CACHEBUST
# Copy setup scripts and IAC configuration
COPY scripts/setup_keycloak.py /app/scripts/setup_keycloak.py
COPY scripts/setup_gitea.py /app/scripts/setup_gitea.py
COPY scripts/setup_gate.py /app/scripts/setup_gate.py
COPY scripts/init-entrypoint.sh /app/scripts/init-entrypoint.sh
COPY iac/ /app/iac/

# Fix line endings (in case files were copied from Windows) and make executable
RUN sed -i 's/\r$//' /app/scripts/init-entrypoint.sh && chmod +x /app/scripts/init-entrypoint.sh

# Create marker directory
RUN mkdir -p /init-marker

ENTRYPOINT ["/app/scripts/init-entrypoint.sh"]
