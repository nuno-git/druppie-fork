{
  "name": "druppie-pi-agent",
  "version": "0.1.0",
  "description": "Druppie's coding agent — containerized sandbox execution with Pi SDK extensions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "druppie-pi": "dist/cli.js"
  },
  "pi": {
    "extensions": ["./.pi/extensions/druppie-tools"]
  },
  "scripts": {
    "build": "rm -rf dist && tsc && printf '#!/usr/bin/env node\\nimport \"./src/cli.js\";\\n' > dist/cli.js",
    "start": "node dist/cli.js",
    "docker:build": "docker build -t druppie-pi-agent .",
    "docker:run": "docker run --rm -v $(pwd)/workspace:/workspace -e ANTHROPIC_API_KEY druppie-pi-agent"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "latest",
    "@mariozechner/pi-ai": "latest",
    "@mariozechner/pi-coding-agent": "latest",
    "@sinclair/typebox": "^0.34.0",
    "pi-subagents": "github:nicobailon/pi-subagents",
    "undici": "^7.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
