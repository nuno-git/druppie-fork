# ═══════════════════════════════════════════════════════════════════════════════
# Druppie Pi Agent — Configuration
# Copy to .env and fill in the values you need.
# ═══════════════════════════════════════════════════════════════════════════════

# ── LLM Provider ──────────────────────────────────────────────────────────────
# At least one API key is required. The default model is zai/glm-5.1.

# Anthropic (Claude models)
ANTHROPIC_API_KEY=

# GLM / Z.AI (glm-5.1, glm-5, glm-4.7, glm-4.5-air)
GLM_API_KEY=
ZAI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Other providers (uncomment as needed)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_BASE_URL=
# AZURE_OPENAI_RESOURCE_NAME=
# AZURE_OPENAI_API_VERSION=v1
# AZURE_OPENAI_DEPLOYMENT_NAME_MAP=
# GROQ_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# AI_GATEWAY_API_KEY=
# OPENCODE_API_KEY=
# KIMI_API_KEY=
# MINIMAX_API_KEY=

# ── Git Provider ──────────────────────────────────────────────────────────────
# Which git backend to use for push + PR creation.
# Values: "github_app" (default) | "gitea"
PI_AGENT_GIT_PROVIDER=github_app

# ── GitHub App (when PI_AGENT_GIT_PROVIDER=github_app) ───────────────────────
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Fallback PAT if no App credentials are configured
GITHUB_TOKEN=

# ── Gitea (when PI_AGENT_GIT_PROVIDER=gitea) ─────────────────────────────────
# Internal URL (reachable from this container, e.g. http://gitea:3000)
GITEA_BASE_URL=
GITEA_INTERNAL_URL=
# API token with repo write access
GITEA_TOKEN=

# ── Sandbox Container Runtime ────────────────────────────────────────────────
# Docker runtime for sandbox containers.
#   "kata-runtime" — production: each sandbox is its own microVM
#   "sysbox-runc"  — development: user-namespace isolation, no nested virt
ONESHOT_SANDBOX_RUNTIME=sysbox-runc

# Sandbox container image tags (must be built before first run)
#   docker build -t oneshot-sandbox:latest  sandbox/
#   docker build -t oneshot-push-sandbox:latest  push-sandbox/
ONESHOT_SANDBOX_IMAGE=oneshot-sandbox:latest

# Resource limits per sandbox container
ONESHOT_SANDBOX_MEMORY=4g
ONESHOT_SANDBOX_CPUS=2
ONESHOT_SANDBOX_PIDS=8192

# Network access for sandboxes (1 = allow, 0 = offline)
ONESHOT_SANDBOX_NETWORK=1

# Wall-clock timeout before sandbox is forcibly killed (seconds, default 24h)
ONESHOT_SANDBOX_TIMEOUT=86400

# ── Druppie Compose Networking ───────────────────────────────────────────────
# When running inside the Druppie backend container, sandboxes must join the
# same Docker network so they can be reached by container name.
# Leave empty for standalone CLI mode (port publishing to 127.0.0.1).
PI_AGENT_SANDBOX_NETWORK=

# Override the host address used to reach sandboxes in standalone mode
PI_AGENT_SANDBOX_HOST=127.0.0.1

# ── Bundle Volume (Druppie mode) ─────────────────────────────────────────────
# Named Docker volume for sharing git bundles between the main sandbox and the
# push sandbox. Required when pi_agent runs inside a container (bind mounts
# from inside the backend container don't resolve on the host daemon).
PI_AGENT_BUNDLE_VOLUME=

# Path where the backend container mounts the bundle volume.
# Only relevant when PI_AGENT_BUNDLE_VOLUME is set.
PI_AGENT_BUNDLE_HOST_DIR=/app/pi_agent_bundles

# ── Druppie Event Ingest (optional — for subprocess mode) ────────────────────
# HTTP endpoint for streaming journal events back to the Druppie backend.
PI_AGENT_INGEST_URL=
PI_AGENT_INGEST_TOKEN=
PI_AGENT_RUN_ID=

# ── Pi SDK Internals ─────────────────────────────────────────────────────────
# Override Pi's config directory (default: ~/.pi/agent)
PI_CODING_AGENT_DIR=

# Override Pi's package directory (for Nix/Guix store paths)
PI_PACKAGE_DIR=

# Disable startup network operations
# PI_OFFLINE=1

# Base URL for /share command
# PI_SHARE_VIEWER_URL=https://pi.dev/session/

# Skip version check at startup
# PI_SKIP_VERSION_CHECK=1

# Extended prompt cache retention (Anthropic: 1h, OpenAI: 24h)
# PI_CACHE_RETENTION=long
