<?xml version="1.0" encoding="UTF-8"?>
<!--
  XFCE panel config for the noVNC desktop. Pins VS Code and Terminator
  launchers next to the Applications menu so they are one click away.
  Loaded from ~/.config/xfce4/xfconf/xfce-perchannel-xml/ on first
  session start.
-->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <property name="panel-0" type="string" value="panel-0">
      <property name="position" type="string" value="p=12;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="size" type="uint" value="26"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="autohide-behavior" type="uint" value="0"/>
      <property name="nrows" type="uint" value="1"/>
      <property name="mode" type="uint" value="0"/>
      <property name="plugin-ids" type="array">
        <property name="plugin-1" type="int" value="1"/>
        <property name="plugin-2" type="int" value="2"/>
        <property name="plugin-15" type="int" value="15"/>
        <property name="plugin-16" type="int" value="16"/>
        <property name="plugin-3" type="int" value="3"/>
        <property name="plugin-4" type="int" value="4"/>
        <property name="plugin-5" type="int" value="5"/>
        <property name="plugin-6" type="int" value="6"/>
        <property name="plugin-10" type="int" value="10"/>
        <property name="plugin-7" type="int" value="7"/>
      </property>
    </property>
  </property>
  <property name="plugins">
    <property name="plugin-1" type="string" value="applicationsmenu"/>
    <property name="plugin-2" type="string" value="separator"/>
    <property name="plugin-15" type="string" value="launcher">
      <property name="items" type="array">
        <property name="item-0" type="string" value="code.desktop"/>
      </property>
    </property>
    <property name="plugin-16" type="string" value="launcher">
      <property name="items" type="array">
        <property name="item-0" type="string" value="terminator.desktop"/>
      </property>
    </property>
    <property name="plugin-3" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
    </property>
    <property name="plugin-4" type="string" value="tasklist"/>
    <property name="plugin-5" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
    </property>
    <property name="plugin-6" type="string" value="systray"/>
    <property name="plugin-10" type="string" value="clock"/>
    <property name="plugin-7" type="string" value="actions"/>
  </property>
</channel>
