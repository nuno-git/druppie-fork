{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://druppie/docs/adrs/adr.schema.json",
  "title": "ADR frontmatter",
  "description": "Required YAML frontmatter for an Architecture Decision Record. Definition only; enforcement is a later story.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "date", "deciders", "supersedes", "superseded_by", "linked_prd", "linked_research"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{3}$", "description": "3-digit zero-padded string, matches filename prefix." },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "accepted", "deprecated", "superseded"] },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "deciders": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "supersedes": { "oneOf": [{ "type": "string", "pattern": "^[0-9]{3}$" }, { "type": "null" }] },
    "superseded_by": { "oneOf": [{ "type": "string", "pattern": "^[0-9]{3}$" }, { "type": "null" }] },
    "linked_prd": { "type": ["string", "null"] },
    "linked_research": { "type": ["string", "null"] }
  }
}
