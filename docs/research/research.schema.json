{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://druppie/docs/research/research.schema.json",
  "title": "Research doc frontmatter",
  "description": "Required YAML frontmatter for a research document. Definition only; enforcement is a later story.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "author", "date", "outcome"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "complete"] },
    "author": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "outcome": { "oneOf": [{ "type": "string", "pattern": "^adr-[0-9]{3}$" }, { "type": "null" }] },
    "linked_adrs": {
      "description": "Optional list of repo-root-relative paths to related ADRs. Resolved (existence-checked) by scripts/validate_docs.py.",
      "type": ["array", "null"],
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
