FROM python:3.12-slim

LABEL maintainer="druppie"
LABEL description="Druppie sandbox base image for per-agent isolated containers"

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    nodejs \
    npm \
    ripgrep \
    findutils \
    jq \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip setuptools wheel
