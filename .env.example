# These ports match the k3s NodePorts. Docker-compose is deprecated — see docs/K3S-DEV-SETUP.md
# =============================================================================
# Druppie Governance Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Variables with defaults (shown after :-) are optional.
# Variables without defaults are REQUIRED.
# =============================================================================

# =============================================================================
# HOST CONFIGURATION
# =============================================================================

# Docker Compose project name - prefixes container, volume, and network names.
# Load-bearing: reset-db, reset-cache, reset-hard, and sandbox-manager derive
# container/volume/network names from it (e.g. <project>-gitea-1,
# <project>_sandbox, <project>_sandbox_dep_cache). Defaults to "druppie".
# Only change it if you run multiple Druppie stacks side by side.
# COMPOSE_PROJECT_NAME=druppie

# External hostname - change for production deployments
EXTERNAL_HOST=localhost

# Druppie public domain - used by oauth2-proxy, Caddy, and gate setup
# Set to your full public hostname (e.g., druppie.example.com)
# Defaults to localhost for local development
# DRUPPIE_DOMAIN=localhost

# =============================================================================
# PUBLIC URLS (override for reverse proxy / HTTPS deployments)
# =============================================================================
# By default, public URLs are derived as http://EXTERNAL_HOST:PORT.
# If you run a reverse proxy (nginx/caddy) with TLS termination,
# uncomment and set these to your HTTPS URLs (no port needed).
# This affects: CORS origins, Keycloak redirect URIs, frontend build args.
# FRONTEND_PUBLIC_URL=https://druppie.example.com
# BACKEND_PUBLIC_URL=https://druppie.example.com
# KEYCLOAK_PUBLIC_URL=https://druppie.example.com
# GITEA_PUBLIC_URL=https://gitea.druppie.example.com
# CORS_ORIGINS=https://druppie.example.com

# Keycloak HTTPS settings (only needed when behind a reverse proxy with TLS)
# KC_HOSTNAME_PORT=
# KC_HOSTNAME_STRICT_HTTPS=true

# =============================================================================
# DATABASE PASSWORDS
# =============================================================================

# Application database (PostgreSQL)
DRUPPIE_DB_PASSWORD=druppie_secret

# Keycloak database
KEYCLOAK_DB_PASSWORD=keycloak_secret

# Gitea database
GITEA_DB_PASSWORD=gitea_secret

# =============================================================================
# KEYCLOAK (Identity Provider)
# =============================================================================

# Keycloak admin credentials (for master realm)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# OAuth2 client secrets (auto-generated during setup, or set manually)
# These are used for backend-to-keycloak and gitea-to-keycloak auth
KEYCLOAK_CLIENT_SECRET=

# =============================================================================
# GITEA (Git Server)
# =============================================================================

# Gitea admin user (created during initialization)
GITEA_ADMIN_USER=gitea_admin
GITEA_ADMIN_PASSWORD=GiteaAdmin123
GITEA_ADMIN_EMAIL=admin@druppie.local

# Gitea access token for MCP services (auto-generated during init)
# If empty, git push operations from MCP coding server won't work
GITEA_TOKEN=

# =============================================================================
# LLM CONFIGURATION (REQUIRED - set at least one provider)
# =============================================================================
# Both providers use LiteLLM internally for standardized tool calling.

# Provider: zai, deepinfra, deepseek, azure_foundry, ollama, openrouter, llmkube
LLM_PROVIDER=zai

# Override: force ALL agents to use this provider/model (ignores YAML per-agent config)
# LLM_FORCE_PROVIDER=
# LLM_FORCE_MODEL=

# --- Z.AI GLM Configuration ---
ZAI_API_KEY=
ZAI_MODEL=glm-4.7
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# --- DeepInfra Configuration ---
# Uncomment and set to use DeepInfra instead:
# DEEPINFRA_API_KEY=
# DEEPINFRA_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct

# --- Embedding Provider (for module-vectorstore / RAG) ---
# Required when the chat provider doesn't support embeddings (e.g. Z.AI coding API).
# Falls back to: DEEPINFRA_API_KEY → chat provider if not set.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# --- Azure Foundry Configuration ---
# Uncomment and set to use Azure Foundry instead:
# FOUNDRY_API_KEY=
# FOUNDRY_MODEL=GPT-5-MINI
# FOUNDRY_API_URL=https://druppie-resource.openai.azure.com
#
# Claude models on Azure Foundry (e.g. claude-sonnet-4-6) require:
#   1. A serverless model deployment in Azure AI Foundry portal (ai.azure.com)
#   2. The Anthropic endpoint URL (services.ai.azure.com, NOT openai.azure.com)
# FOUNDRY_ANTHROPIC_URL=https://druppie-resource.services.ai.azure.com

# --- OpenRouter Configuration ---
# Uncomment and set to use OpenRouter:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-3-27b-it
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Ollama Configuration ---
# No API key required by default. Set OLLAMA_API_KEY only if your endpoint uses auth.
# Available models: gpt-oss:120b, gpt-oss:20b, qwen3-coder:30b, deepseek-r1:32b, gemma3:27b
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_BASE_URL=https://ollama.waterschap.org/v1
# OLLAMA_API_KEY=

# --- LLMKube / in-cluster vLLM Configuration ---
# OpenAI-compatible endpoint served by LLMKube+vLLM. No API key required.
# Default below is the external ingress (for local dev / off-cluster use).
# In-cluster deployments (backend running on RKE2) should instead set:
#   LLMKUBE_BASE_URL=http://qwen.llm.svc.cluster.local:8000/v1
# (this is wired automatically via helm values-rijnland.yaml).
# LLMKUBE_BASE_URL=https://llm.rijnland.dev/v1
# LLMKUBE_MODEL=Qwen/Qwen3.6-27B
# LLMKUBE_API_KEY=

# --- Translation Model Override ---
# By default, translation uses DeepInfra + Gemma 3 27B, or falls back to any available provider.
# Override with specific provider/model:
# TRANSLATION_PROVIDER=openrouter
# TRANSLATION_MODEL=google/gemma-3-27b-it
# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment: "development" (default) or "production"/"staging"
# In production/staging, INTERNAL_API_KEY and SANDBOX_API_SECRET MUST be set
# to non-default values or the backend will refuse to start.
ENVIRONMENT=development

# Development mode - set to true to bypass Keycloak authentication
DEV_MODE=false

# Internal API key for MCP server communication (CHANGE for production!)
INTERNAL_API_KEY=druppie-internal-secret-key

# Shared secret that deployed apps use to call /api/modules/{id}/call through
# the Druppie SDK. Auto-injected into app containers by compose_up. Leave empty
# in dev for an unauthenticated proxy (a warning is logged). REQUIRED in production.
DRUPPIE_MODULE_API_TOKEN=

# MCP Microservices toggle
USE_MCP_MICROSERVICES=true

# =============================================================================
# PORT CONFIGURATION (k3s NodePorts)
# =============================================================================
# These match the k3s NodePorts. See docs/K3S-DEV-SETUP.md.

DRUPPIE_DB_PORT=5533
KEYCLOAK_PORT=30002
GITEA_PORT=30003
# GITEA_SSH_PORT=2223
BACKEND_PORT=30000
FRONTEND_PORT=30001
# MCP_CODING_PORT=9001
# MCP_DOCKER_PORT=9002
# MCP_HITL_PORT=9003
# MCP_FILESEARCH_PORT=9004
# MCP_WEB_PORT=9005
# MCP_ARCHIMATE_PORT=9006
# MCP_LLM_PORT=9008
# MCP_REGISTRY_PORT=9007
# MCP_DATA_ACCESS_PORT=9010
# MCP_VISION_PORT=9011
# MCP_VECTORSTORE_PORT=9012
# ADMINER_PORT=8081

# =============================================================================
# SANDBOX / CODING AGENT (integrated - sandbox infrastructure starts automatically)
# =============================================================================
# Shared HMAC secret for sandbox authentication (must match between services)
SANDBOX_API_SECRET=sandbox-dev-secret
# LLM model used inside sandbox containers (REQUIRED — no universal default)
# Must match a model available on your configured LLM provider.
# Example: zai-coding-plan/glm-4.7, deepinfra/Qwen/Qwen3-Coder, ollama/gpt-oss:120b
SANDBOX_MODEL=
# Resource limits for sandbox containers (optional)
# SANDBOX_MEMORY_LIMIT=4g
# SANDBOX_CPU_LIMIT=2

# =============================================================================
# DATA ACCESS MCP (Azure Data Lake, Azure SQL, and more)
# =============================================================================
# Configure data sources using DATA_SOURCE_N env vars (N = 1-9)
# Format: type:name:config_parts...

# Azure Data Lake (key-based):
# DATA_SOURCE_1=azure-datalake:mydatalake:account_name:storage_key
# Azure Data Lake (public/anonymous):
# DATA_SOURCE_2=azure-datalake:publiclake:account_name

# Azure SQL (connection string):
# DATA_SOURCE_3=azure-sql:mydatabase:driver=ODBC+Driver+18+for+SQL+Server;Server=tcp:server.database.windows.net,1433;Database=mydb;Uid=user;Pwd=pass;Encrypt=yes;TrustServerCertificate=no;Connection+Timeout=30

# Azure SQL (OBO token - fresh per request, NO caching):
# DATA_SOURCE_4=azure-sql-obo:mysqlobo:tenant_id:client_id:client_secret:scope:server.database.windows.net:database_name

# Important: OBO tokens are NEVER cached or stored - fetched fresh per request

# =============================================================================
# AZURE DEVOPS MCP (read-only backlog, ONE project only)
# =============================================================================
# Agents can read backlog / work items from a SINGLE Azure DevOps project.
# Isolation is enforced two ways:
#   1. Grant the service principal read-only access to ONLY this one project in
#      Azure DevOps (it must have no access to other projects).
#   2. The MCP server is hard-scoped to AZURE_DEVOPS_PROJECT and exposes no
#      project picker / list_projects tool.
# AZURE_DEVOPS_ORG_URL=https://dev.azure.com/<org>
# AZURE_DEVOPS_PROJECT=<the-one-allowed-project>
# AZURE_DEVOPS_TENANT_ID=
# AZURE_DEVOPS_CLIENT_ID=
# AZURE_DEVOPS_CLIENT_SECRET=
# MCP_AZUREDEVOPS_PORT=9012

# Sandbox runtime: "docker" (default, cross-platform) or "kata" (VM isolation, Linux + KVM only)
# See docs/KATA_CONTAINERS.md for Kata setup instructions
SANDBOX_RUNTIME=docker
# Kata-specific settings (only used when SANDBOX_RUNTIME=kata)
# KATA_RUNTIME=io.containerd.kata.v2
# CONTAINERD_NAMESPACE=default

# =============================================================================
# TESTING FRAMEWORK
# =============================================================================
# Number of tests that run concurrently when multiple tests are selected.
# Default: 3. Increase for faster batch runs if resources allow.
PARALLEL_TEST_WORKERS=10
# Per-test timeout in seconds (default: 600 = 10 minutes)
# TEST_TIMEOUT_SECONDS=600

# =============================================================================
# DRUPPIE CORE REPO (for update_core_builder agent - self-improvement via PRs)
# =============================================================================
# The repo where Druppie's own codebase lives on Gitea (aigit.waterschap.org).
# update_core clone/push/PR uses the external Gitea URL, while project repos
# use the internal Gitea URL (GITEA_INTERNAL_URL).
DRUPPIE_CORE_GITEA_URL=https://aigit.waterschap.org
DRUPPIE_CORE_REPO_OWNER=ai
DRUPPIE_CORE_REPO_NAME=druppie
DRUPPIE_CORE_REPO_BRANCH=colab-dev

# =============================================================================
# DOCKER SOCKET (optional - for rootless Docker)
# =============================================================================
# Set this to your rootless Docker socket if not using system Docker
# Find your path with: echo $XDG_RUNTIME_DIR/docker.sock
# DOCKER_SOCK=/run/user/1000/docker.sock
